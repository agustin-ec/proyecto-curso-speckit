# Secret key for JWT signing (HS256)
# Generate a cryptographically secure key with: openssl rand -hex 32
SECRET_KEY=cambiar_por_clave_secreta_generada_con_openssl_rand_hex_32

# Database connection URL (SQLite for local dev/testing, PostgreSQL for production)
DATABASE_URL=sqlite:///./gastos.db

# JWT Access Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Demo user email for stdio transport fallback in MCP sessions
DEMO_USER_EMAIL=demo@gastos.local
